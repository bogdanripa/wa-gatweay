# --- shared ------------------------------------------------------------------

# Mongo. Can be the same Atlas cluster the bots use; give it its own database.
# All numbers share this; their state is namespaced by session id.
WA_MONGO_URL=mongodb+srv://user:pass@cluster.mongodb.net
WA_MONGO_DB=wa_gateway

# This gateway's own public HTTPS URL, no trailing slash. Media links handed to
# the bots are built from it, and they fetch those links server-side.
WA_PUBLIC_URL=https://wa-gateway-coolify.bogdanripa.com

# Password for the /admin pairing page (any username works).
WA_ADMIN_PASSWORD=

PORT=8080

# --- numbers -----------------------------------------------------------------
#
# One block per WhatsApp number, exactly like whapi channels: the bearer token
# selects the number, so each bot sends its own token and reaches its own
# account. Indices need not be contiguous; 1..64 are scanned.
#
#   _ID           stable, [a-z0-9_-], namespaces all stored state — never change
#   _TOKEN        set the matching bot's WHAPI_TOKEN to this exact value
#   _WEBHOOK_URL  that bot's own /whapi endpoint
#
# Each token is its own variable so you can rotate one number's credentials
# without touching any other's.

WA_SESSION_1_ID=gepetel
WA_SESSION_1_TOKEN=
WA_SESSION_1_WEBHOOK_URL=https://europe-west3-<project>.cloudfunctions.net/gepetel/whapi
# Optional: pair with an 8-char code instead of a QR. Digits only, country code
# included. Leave unset for the QR flow.
# WA_SESSION_1_PAIR_PHONE=40750271099
# Optional per-number override of WA_SEND_RATE_PER_MINUTE.
# WA_SESSION_1_SEND_RATE_PER_MINUTE=20

# WA_SESSION_2_ID=second-bot
# WA_SESSION_2_TOKEN=
# WA_SESSION_2_WEBHOOK_URL=https://.../whapi

# --- optional ----------------------------------------------------------------

# How long downloaded media stays fetchable. The bots resolve media synchronously
# on receipt, so this mainly covers retries — but gepetel's setLastImage feature
# re-reads the most recent image later, so don't go below a few hours.
WA_MEDIA_TTL_HOURS=48
WA_MEDIA_DIR=/tmp/wa-media

# Default ceiling on outbound messages per minute, per number. gepetel has its
# own per-group daily cap; this is a floor under any bug that would spam.
WA_SEND_RATE_PER_MINUTE=20

WA_LOG_LEVEL=info
# Baileys is extremely chatty below "warn".
WA_BAILEYS_LOG_LEVEL=warn
