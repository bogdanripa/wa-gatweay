# --- required ----------------------------------------------------------------

# Mongo. Can be the same Atlas cluster the bots use; give it its own database.
# All numbers share it; their state is namespaced by session id.
#
# On Pironman there is nothing to set: the app's attached database is injected as
# DATABASE_URL, which is used automatically when WA_MONGO_URL is unset — and it
# is recomposed on every deploy, because the database container's hostname
# changes whenever that resource is rebuilt. Don't copy it into WA_MONGO_URL.
WA_MONGO_URL=mongodb+srv://user:pass@cluster.mongodb.net

# Leave empty to use the database named in the connection string. That is what
# you want with any managed database: its user is authorised for exactly that one
# database, and a different name here connects fine and then fails on the first
# index build with a permissions error that looks nothing like the cause.
WA_MONGO_DB=

# This gateway's own public HTTPS URL — the app root, no trailing slash and no
# /api suffix. Media links handed to the bots are built from it (they land at
# <this>/api/media/...), and the bots fetch those links server-side.
WA_PUBLIC_URL=https://wa-gateway-coolify.bogdanripa.com

# Secret for the management console. It adds WhatsApp numbers and can read every
# bot's token, so treat it as the most sensitive value here: at least 16
# characters, and the gateway refuses to start below that.
#
#     openssl rand -base64 32
#
# Unset is allowed, but only as a way station: the gateway boots with the whole
# management API switched off (503 on every route) and says so loudly. That
# exists because a platform won't accept environment variables for an app that
# has never produced a running container, so the first deploy of a fresh install
# necessarily happens before this is set.
WA_MANAGEMENT_KEY=

PORT=8080

# --- numbers -----------------------------------------------------------------
#
# There is nothing to configure here. Numbers live in Mongo and are added from
# the management console, which is the whole reason they moved out of this file:
# a redeploy replaces the container, and waiting for one just to host another
# number was the friction worth removing.
#
# Each number gets a generated bearer token — set the matching bot's WHAPI_TOKEN
# to it, and its WHAPI_BASE_URL to <WA_PUBLIC_URL>/api. The token selects which
# WhatsApp number that bot reaches, exactly as a whapi channel token does.

# --- optional ----------------------------------------------------------------

# How long downloaded media stays fetchable. The bots resolve media synchronously
# on receipt, so this mainly covers retries — but gepetel's setLastImage feature
# re-reads the most recent image later, so don't go below a few hours.
WA_MEDIA_TTL_HOURS=48
WA_MEDIA_DIR=/tmp/wa-media

# Default ceiling on outbound messages per minute, per number, overridable per
# number in the console. gepetel has its own per-group daily cap; this is a floor
# under any bug that would spam. A non-numeric value here is a startup error
# rather than a silently disabled limiter.
WA_SEND_RATE_PER_MINUTE=20

WA_LOG_LEVEL=info
# Baileys is extremely chatty below "warn".
WA_BAILEYS_LOG_LEVEL=warn
