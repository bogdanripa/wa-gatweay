{
  "name": "wa-gateway",
  "version": "1.0.0",
  "description": "Self-hosted whapi.cloud-compatible WhatsApp gateway backed by Baileys. Drop-in replacement for gepetel's whapi dependency.",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsc --watch & nodemon dist/server.js",
    "dev:console": "node dev/serve.mjs",
    "test": "node --test test/*.test.mjs",
    "test:smoke": "node test/smoke.mjs"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "baileys": "7.0.0-rc14",
    "express": "^4.21.2",
    "mongodb": "^6.12.0",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.5",
    "mongodb-memory-server": "^11.2.0",
    "typescript": "^5.7.3"
  }
}
